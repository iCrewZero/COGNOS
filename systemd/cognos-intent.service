# cognoS/OS — Intent engine systemd unit
#
# Purpose:
#   Runs the intent engine, which parses user intent (text/voice/structured)
#   into a validated action graph consumed by the orchestrator and HAL.
#
# Dependencies:
#   - cognos-ipc.service (the IPC bus must be up before the engine registers
#                         and serves DispatchIntent)
#   - cognos-hal.service (HAL must be up before intent issues any gate requests)
#   - network.target      (model weights may be fetched on first boot)
#
# Owner: COGNOS core team
# Manpage: https://cognos.os/docs/intent
[Unit]
Description=COGNOS intent engine
Documentation=https://cognos.os/docs/intent
After=network.target cognos-ipc.service cognos-hal.service
# Soft dependencies: the engine registers on the IPC bus and calls HAL, but its
# client connections are non-fatal (it degrades rather than refusing to start),
# so these are Wants (ordering via After) rather than a hard Requires.
Wants=cognos-ipc.service cognos-hal.service
PartOf=cognos.target

# Rate-limit restarts (these belong in [Unit] for modern systemd).
StartLimitBurst=3
StartLimitIntervalSec=60

[Service]
Type=exec
User=cognos
Group=cognos
ExecStart=/usr/lib/cognos/cognos-intent --config /etc/cognos/intent.toml

# Runtime + state directories (systemd creates these with cognos ownership)
RuntimeDirectory=cognos
StateDirectory=cognos/intent
WorkingDirectory=/var/lib/cognos/intent

# --- Hardening ---
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX AF_INET
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
CapabilityBoundingSet=
SystemCallFilter=@system-service

# --- Restart policy ---
Restart=on-failure
RestartSec=5s

SyslogIdentifier=cognos-intent

[Install]
WantedBy=cognos.target

# TODO(v1): add ExecReload=/bin/kill -HUP $MAINPID once config hot-reload lands
