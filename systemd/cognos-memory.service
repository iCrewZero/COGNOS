# cognoS/OS — Memory service systemd unit
#
# Purpose:
#   Runs the COGNOS memory service: semantic vector memory (ChromaDB) fronted
#   by a secure memory fabric that mlocks keys, embeddings, and secrets to
#   prevent them from being paged to swap or ANFS cold storage.
#
# mlock note:
#   Memory service mlocks secure regions for keys and secrets.
#   LimitMEMLOCK=infinity overrides the default 64KiB RLIMIT_MEMLOCK so the
#   secure_pool allocator can pin multi-megabyte regions.
#
# Owner: COGNOS core team
# Manpage: https://cognos.os/docs/memory
[Unit]
Description=COGNOS memory service — semantic memory + secure fabric
Documentation=https://cognos.os/docs/memory
After=network.target cognos-hal.service
PartOf=cognos.target

[Service]
Type=exec
User=cognos
Group=cognos
ExecStart=/usr/lib/cognos/cognos-memory --config /etc/cognos/memory.toml

# ChromaDB indices + secure pool arena
RuntimeDirectory=cognos
StateDirectory=cognos/memory
WorkingDirectory=/var/lib/cognos/memory

# Memory service mlocks secure regions for keys and secrets
LimitMEMLOCK=infinity

# --- Hardening ---
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX AF_INET
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
CapabilityBoundingSet=
SystemCallFilter=@system-service

# --- Restart policy ---
Restart=on-failure
RestartSec=5s
StartLimitBurst=3
StartLimitIntervalSec=60

SyslogIdentifier=cognos-memory

[Install]
WantedBy=cognos.target

