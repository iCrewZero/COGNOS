# COGNOS OS — Sway config overrides
# This file is installed to /etc/cognos/sway.config.d/ and
# included by the main sway config. Do NOT put exec_always or
# service startup here — that belongs in cognos-session.sh.
# Owner: iCrewZero

# ═══════════════════════════════════════════════════════════════════════════════
# COGNOS OS — Sway Window Manager Configuration
# ═══════════════════════════════════════════════════════════════════════════════
#
# Purpose:
#   Minimal Sway configuration tuned for COGNOS OS. This config enables
#   COGNOS shell integration: the COGNOS shell (intent bar, approval UI,
#   memory browser) provides most of the user-facing chrome; Sway is
#   responsible only for tiling, focus, and input handling.
#
#   exec'd on login. Per-user overrides live in /etc/cognos/sway.d/*.conf
#   and are included at the bottom of this file.
#
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Variables ─────────────────────────────────────────────────────────────────
set $mod  Mod4
set $term cognos-terminal
set $menu cognos-intent-bar

# ─── COGNOS Session Integration ────────────────────────────────────────────────
# Start the per-user UI agent (intent routing, approval prompts, telemetry).

# Re-establish the COGNOS session environment on every config (re)load.

# ─── Output ────────────────────────────────────────────────────────────────────
output * bg /usr/share/cognos/wallpaper.png fill

# ─── Input ─────────────────────────────────────────────────────────────────────
input * {
    # Keyboard: US layout by default, Caps as Ctrl, Compose on Right Alt.
    xkb_layout  us
    xkb_options caps:ctrl_modifier,compose:ralt

    # Touchpad: tap-to-click, natural scroll, disable-while-typing.
    tap                enabled
    natural_scroll     enabled
    dwt                enabled
    middle_emulation   enabled
}

# ─── Keybindings ───────────────────────────────────────────────────────────────
# Use Mod4 (Super) as the primary modifier.

# COGNOS-specific bindings. These intentionally override Sway defaults where
# the default binding collides with a COGNOS chrome binding (see $mod+Space).
bindsym $mod+Space       exec cognos intent-bar show
bindsym $mod+a           exec cognos approval show
bindsym $mod+m           exec cognos memory-browser
bindsym $mod+Shift+e     exec cognos-session-logout

# Terminal and launcher.
bindsym $mod+Return      exec $term
bindsym $mod+d           exec $menu

# Window management.
bindsym $mod+Shift+q     kill
bindsym $mod+Shift+c     reload
bindsym $mod+Shift+r     restart

# Focus (arrow keys).
bindsym $mod+Left        focus left
bindsym $mod+Down        focus down
bindsym $mod+Up          focus up
bindsym $mod+Right       focus right

# Focus (vim-style).
bindsym $mod+h           focus left
bindsym $mod+j           focus down
bindsym $mod+k           focus up
bindsym $mod+l           focus right

# Move focused container.
bindsym $mod+Shift+Left  move left
bindsym $mod+Shift+Down  move down
bindsym $mod+Shift+Up    move up
bindsym $mod+Shift+Right move right

# Workspaces.
bindsym $mod+1 workspace 1
bindsym $mod+2 workspace 2
bindsym $mod+3 workspace 3
bindsym $mod+4 workspace 4
bindsym $mod+5 workspace 5
bindsym $mod+6 workspace 6
bindsym $mod+7 workspace 7
bindsym $mod+8 workspace 8
bindsym $mod+9 workspace 9
bindsym $mod+0 workspace 10

bindsym $mod+Shift+1 move container to workspace 1
bindsym $mod+Shift+2 move container to workspace 2
bindsym $mod+Shift+3 move container to workspace 3
bindsym $mod+Shift+4 move container to workspace 4
bindsym $mod+Shift+5 move container to workspace 5
bindsym $mod+Shift+6 move container to workspace 6
bindsym $mod+Shift+7 move container to workspace 7
bindsym $mod+Shift+8 move container to workspace 8
bindsym $mod+Shift+9 move container to workspace 9
bindsym $mod+Shift+0 move container to workspace 10

# Layout.
bindsym $mod+b           splith
bindsym $mod+v           splitv
bindsym $mod+f           fullscreen toggle
bindsym $mod+e           layout toggle split
bindsym $mod+s           layout stacking
bindsym $mod+w           layout tabbed

# Floating.
bindsym $mod+Shift+space floating toggle

# Resize mode.
bindsym $mod+r           mode "resize"

# ─── Bar ───────────────────────────────────────────────────────────────────────
# COGNOS provides its own shell chrome; disable the built-in swaybar.
bar {
    mode invisible
    status_command /bin/true
}

# ─── Window Rules ──────────────────────────────────────────────────────────────
# COGNOS chrome should always float above the tiling layer.
for_window [app_id="cognos-approval"]   floating enable, border pixel 2
for_window [app_id="cognos-intent-bar"] floating enable, border pixel 2

# ─── Gestures ──────────────────────────────────────────────────────────────────
# Touchpad gestures for workspace switching (libinput).
bindgesture swipe:3:left  workspace prev
bindgesture swipe:3:right workspace next
bindgesture swipe:4:up    workspace prev
bindgesture swipe:4:down  workspace next

# ─── Modes ─────────────────────────────────────────────────────────────────────
mode "resize" {
    bindsym Left  resize shrink width  10 px
    bindsym Down  resize grow   height 10 px
    bindsym Up    resize shrink height 10 px
    bindsym Right resize grow   width  10 px

    bindsym h     resize shrink width  10 px
    bindsym j     resize grow   height 10 px
    bindsym k     resize shrink height 10 px
    bindsym l     resize grow   width  10 px

    bindsym Return mode "default"
    bindsym Escape mode "default"
}

# ─── Per-user Overrides ────────────────────────────────────────────────────────
include /etc/cognos/sway.d/*.conf

# TODO(v1): per-output idle/lock rules, hardware-specific output configs,
#           xdg-desktop-portal integration, idle inhibit during agent runs,
#           scratchpad bindings for transient COGNOS surfaces.
# v0: stub — minimal config, COGNOS shell provides most chrome
