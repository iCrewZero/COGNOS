# cognoS/OS — UI agent systemd unit
#
# Purpose:
#   Runs the COGNOS UI agent: Wayland shell surface host, widget compositor,
#   and intent bar surface. Renders the AI-aware desktop chrome.
#
# Placement note:
#   UI agent runs in user session, not system.
#   This unit is provided as a system template for testing; in production it
#   is symlinked into ~/.config/systemd/user/ and started via graphical-session.
#
# Hardening note:
#   ProtectSystem=false because the UI agent needs GPU/DRM render node access
#   and shared memory import for client buffers. All other hardening remains
#   in force. A v1 user-session variant will tighten this via a dedicated
#   graphics slice.
#
# Owner: COGNOS core team
# Manpage: https://cognos.os/docs/ui-agent
[Unit]
Description=COGNOS UI agent — Wayland shell and widgets
Documentation=https://cognos.os/docs/ui-agent
After=graphical-session.target cognos-hal.service
PartOf=graphical-session.target cognos.target

[Service]
# Owner: iCrewZero — changed from simple to exec to match all other COGNOS services
Type=exec
User=cognos
Group=cognos
ExecStart=/usr/lib/cognos/cognos-ui-agent

# UI agent runs in user session, not system
Environment=WAYLAND_DISPLAY=wayland-0
Environment=XDG_RUNTIME_DIR=/run/user/1000

RuntimeDirectory=cognos

# --- Hardening (relaxed: ProtectSystem=false, since UI needs GPU/DRM access) ---
NoNewPrivileges=true
ProtectSystem=false
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
CapabilityBoundingSet=
SystemCallFilter=@system-service

# --- Restart policy ---
Restart=on-failure
RestartSec=5s
StartLimitBurst=3
StartLimitIntervalSec=60

SyslogIdentifier=cognos-ui-agent

[Install]
WantedBy=graphical-session.target

