# cognoS/OS — Adaptive resource scheduler systemd unit
#
# Purpose:
#   Runs the adaptive scheduler: consumes telemetry from the eBPF probes and
#   the LSTM predictor, then drives cgroup v2 CPU/memory/IO weights and
#   real-time priority via dbus -> systemd and the cgroupfs.
#
# Capabilities note:
#   Scheduler writes to /sys/fs/cgroup via dbus; needs CAP_SYS_ADMIN.
#   CAP_SYS_NICE is required for SCHED_DEADLINE / SCHED_RR adjustments on
#   latency-sensitive AI worker threads.
#
# Owner: COGNOS core team
# Manpage: https://cognos.os/docs/scheduler
[Unit]
Description=COGNOS adaptive resource scheduler
Documentation=https://cognos.os/docs/scheduler
After=network.target cognos-hal.service cognos-llm.service
Wants=cognos-llm.service
PartOf=cognos.target
StartLimitBurst=3
StartLimitIntervalSec=60

[Service]
Type=exec
User=cognos
Group=cognos
ExecStart=/usr/lib/cognos/cognos-scheduler --config /etc/cognos/scheduler.toml

# Scheduler state: predictor model cache, policy snapshots
RuntimeDirectory=cognos
StateDirectory=cognos/scheduler
WorkingDirectory=/var/lib/cognos/scheduler

# --- Hardening (relaxed capability set only; everything else strict) ---
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
# Scheduler writes to /sys/fs/cgroup via dbus; needs CAP_SYS_ADMIN
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_NICE
SystemCallFilter=@system-service

# --- Restart policy ---
Restart=on-failure
RestartSec=5s

SyslogIdentifier=cognos-scheduler

[Install]
WantedBy=cognos.target

# v0: stub — scheduler daemon binary path is illustrative
# TODO(v1): add Delegate=yes + Slice=cognos.slice once nested cgroup delegation lands
# TODO(v1): replace dbus path with a direct cgroupfs writer once kernel CGroupContext lands
