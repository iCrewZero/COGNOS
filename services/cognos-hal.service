# cognoS/OS — Human Approval Layer (HAL) systemd unit
#
# Purpose:
#   Runs the HAL daemon: risk-weighted human governance gate that every
#   privileged AI action must pass through. HAL is the immutability root of
#   the OS — no AI component, even with root elsewhere, may modify HAL.
#
# Immutability note:
#   HAL must be immutable: AI cannot modify HAL even with root elsewhere.
#   The strict syscall filter and empty capability set below enforce this at
#   the unit level; AppArmor profile (security/apparmor/cognos-hal) and the
#   measured-boot attestation enforce it at the LSM and bootloader level.
#
# Owner: COGNOS core team
# Manpage: https://cognos.os/docs/hal
[Unit]
Description=COGNOS HAL — risk-weighted human governance daemon
Documentation=https://cognos.os/docs/hal
After=network.target cognos-ipc.service
Requires=cognos-ipc.service
PartOf=cognos.target
RequiresMountsFor=/var/lib/cognos/hal
StartLimitBurst=3
StartLimitIntervalSec=60

[Service]
Type=exec
User=cognos
Group=cognos
ExecStart=/usr/lib/cognos/cognos-hal --audit /var/lib/cognos/hal/audit.jsonl --config /etc/cognos/hal.toml

# HAL audit log + state
RuntimeDirectory=cognos
StateDirectory=cognos/hal
WorkingDirectory=/var/lib/cognos/hal

# --- Hardening (HAL is the immutability root; lock down hard) ---
# HAL must be immutable: AI cannot modify HAL even with root elsewhere
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
CapabilityBoundingSet=
SystemCallFilter=@system-service ~@privileged
ReadWritePaths=/var/lib/cognos/hal

# --- Restart policy ---
Restart=on-failure
RestartSec=5s

SyslogIdentifier=cognos-hal

[Install]
WantedBy=cognos.target

