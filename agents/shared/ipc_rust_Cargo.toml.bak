[package]
name = "cognos-ipc"
version = "0.1.0"
edition = "2021"
description = "COGNOS inter-agent gRPC IPC layer with mTLS, capability lattice, and audit"

build = "proto/build.rs"

[lib]
name = "cognos_ipc"
path = "src/lib.rs"

[dependencies]
tokio = { version = "1", features = ["full"] }
tokio-stream = { version = "0.1", features = ["net", "sync"] }
tonic = { version = "0.11", features = ["transport", "tls"] }
tonic-health = "0.11"
tonic-reflection = "0.11"
prost = "0.12"
prost-types = "0.12"
serde = { version = "1", features = ["derive"] }
serde_json = "1"
uuid = { version = "1", features = ["v4"] }
ring = "0.17"
rustls = "0.22"
rustls-pemfile = "2"
tokio-rustls = "0.25"
tracing = "0.1"
tracing-subscriber = { version = "0.3", features = ["env-filter"] }
thiserror = "1"
chrono = { version = "0.4", features = ["serde"] }
sha2 = "0.10"
base64 = "0.22"
hex = "0.4"
hostname = "0.4"
anyhow = "1"
tower = { version = "0.4", features = ["full"] }
tower-http = { version = "0.5", features = ["trace"] }
dashmap = "6"
backoff = { version = "0.4", features = ["tokio"] }
async-stream = "0.3"

[build-dependencies]
tonic-build = "0.11"
